//MYJOB1   JOB (ACCT#123),'NEERAJ K',CLASS=A,PRTY=8,             
//             MSGCLASS=A,MSGLEVEL=(1,1),NOTIFY=&SYSUID 
//*
//S1 EXEC PGM=SORT
//SYSOUT DD SYSOUT=*
//SORTIN DD DSN=TEST.INPUT.FILE,DISP=SHR
//SORTOUT DD DSN=TEST.OUTPUT.FILE,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(10,5)),
//            DCB=(RECFM=FB,LRECL=40,BLKSIZE=0,DSORG=PS)
//SYSIN DD *
 OPTION COPY
 OUTFIL INCLUDE=(3,4,CH,EQ,C'key1'),
 IFTRAIL=(HD=YES,TRLID=(1,1,CH,EQ,C'T'),
 TRLUPD=(18:COUNT=(M11,LENGTH=8),
 33:TOT=(8,4,ZD,M11,LENGTH=6)))
/*
//S2 EXEC PGM=SORT
//SYSOUT DD SYSOUT=*
//SORTIN DD DSN=TEST.INPUT.FILE,DISP=SHR
//KEY1OUT DD DSN=TEST.KEY1OUT.FILE,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(10,5)),
//            DCB=(RECFM=FB,LRECL=40,BLKSIZE=0,DSORG=PS)
//KEY2OUT DD DSN=TEST.KEY2OUT.FILE,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(10,5)),
//            DCB=(RECFM=FB,LRECL=40,BLKSIZE=0,DSORG=PS)
//SYSIN DD *
 OPTION COPY
 OUTFIL FNAMES=KEY1OUT,INCLUDE=(3,4,CH,EQ,C'key1'),
 IFTRAIL=(HD=YES,TRLID=(1,1,CH,EQ,C'T'),
 TRLUPD=(18:COUNT=(M11,LENGTH=8),
 33:TOT=(8,4,ZD,M11,LENGTH=6)))
 OUTFIL FNAMES=KEY2OUT,INCLUDE=(3,4,CH,EQ,C'key2'),
 IFTRAIL=(HD=YES,TRLID=(1,1,CH,EQ,C'T'),
 TRLUPD=(18:COUNT=(M11,LENGTH=8),
 33:TOT=(8,4,ZD,M11,LENGTH=6)))
/*
//COMB1 EXEC PGM=ICETOOL
//TOOLMSG DD SYSOUT=*
//DFSMSG DD SYSOUT=*
//IN1 DD DSN=TEST.INPUT.FILE,DISP=SHR
//OUT1 DD DSN=TEST.OUTPUT.FILE,
//            DISP=(NEW,CATLG,DELETE),
//            SPACE=(CYL,(10,5)),
//            DCB=(RECFM=FB,LRECL=30,BLKSIZE=0,DSORG=PS)
//TOOLIN DD *
RESIZE FROM(IN1) TO(OUT1) TOLEN(30)